### ─── SET BUDGET — Overall Monthly Total ────────────────────────────────────
POST {{baseUrl}}/budget
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "category": "Total",
  "monthlyLimit": 50000,
  "month": 5,
  "year": 2025,
  "alertThreshold": 85
}


### ─── GET BUDGETS (current month) ───────────────────────────────────────────
GET {{baseUrl}}/budget
Authorization: Bearer {{token}}


### ─── GET BUDGETS — specific month/year ─────────────────────────────────────
GET {{baseUrl}}/budget?month=5&year=2025
Authorization: Bearer {{token}}


### ─── GET BUDGET ALERTS ──────────────────────────────────────────────────────
# Returns only categories that have crossed their alert threshold
GET {{baseUrl}}/budget/alerts
Authorization: Bearer {{token}}


### ─── DELETE BUDGET ──────────────────────────────────────────────────────────
DELETE {{baseUrl}}/budget/{{budgetId}}
Authorization: Bearer {{token}}
