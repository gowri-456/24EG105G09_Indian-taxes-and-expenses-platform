### ─── SET BUDGET — Food ─────────────────────────────────────────────────────
POST {{baseUrl}}/budget
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "category": "Food & Dining",
  "monthlyLimit": 5000,
  "month": 5,
  "year": 2025,
  "alertThreshold": 80
}


### ─── SET BUDGET — Travel ────────────────────────────────────────────────────
POST {{baseUrl}}/budget
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "category": "Travel & Transport",
  "monthlyLimit": 3000,
  "month": 5,
  "year": 2025,
